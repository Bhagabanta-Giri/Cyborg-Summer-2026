<?xml version="1.0"?>
<robot name="tuktuk">

    <material name="blue">
                <color rgba="0 0 1 1"/>
    </material>
    <material name="white">
                <color rgba="1 1 1 1"/>
    </material>
    <material name="black">
                <color rgba="0 0 0 1"/>
    </material>
    <material name="black_2">
                <color rgba="0 0 0 0.8"/>
    </material>
    <material name="green">
                <color rgba="0 1 0 1"/>
    </material>
    <material name="red">
                <color rgba="1 0 0 1"/>
    </material>
    <material name="yellow">
                <color rgba="1 1 0 1"/>
    </material>


    
    <link name="chassis">
        <visual>
            <geometry>
                <box size="1 0.6 0.06" />
            </geometry>
            <material name="white"/>
        </visual>
    </link>

    <link name="caster_base">
        <visual>
            <geometry>
                <box size="0.1 0.1 0.05"/>
            </geometry>
            <material name="red" />
        </visual>
    </link>
    <joint name="caster_joint" type="fixed">
        <parent link="chassis" />
        <child link="caster_base" />
        <origin rpy="0 0 0" xyz="0.4 0 -0.055"/>
    </joint>

    <link name="caster_stud">
        <visual>
            <geometry>
                <cylinder radius="0.025" length="0.08" />
            </geometry>
            <material name="red" />
        </visual>
    </link>
    <joint name="stud_joint" type="fixed">
        <parent link="caster_base" />
        <child link="caster_stud" />
        <origin rpy="0 0 0" xyz="0 0 -0.065"/>
    </joint>

    <link name="caster_ball">
        <visual>
            <geometry>
                <sphere radius="0.025"/>
            </geometry>
            <material name="black" />
        </visual>
    </link>
    <joint name="ball_n_socket" type="fixed">
        <parent link="caster_stud" />
        <child link="caster_ball" />
        <origin rpy="0 0 0" xyz="0 0 -0.04"/>
    </joint>
    

    <link name="battery">
        <visual>
            <geometry>
                <box size="0.2 0.4 0.1"/>
            </geometry>
            <material name="black" />
        </visual>
    </link>
    <joint name="battery_joint" type="fixed">
        <parent link="chassis" />
        <child link="battery" />
        <origin rpy="0 0 0" xyz="-0.4 0 0.075"/>
    </joint>

    <link name="arduino">
        <visual>
            <geometry>
                <box size="0.3 0.3 0.05"/>
            </geometry>
            <material name="green" />
        </visual>
    </link>
    <joint name="arduino_joint" type="fixed">
        <parent link="chassis" />
        <child link="arduino" />
        <origin rpy="0 0 0" xyz="0 0.15 0.055"/>
    </joint>

    <link name="driver">
        <visual>
            <geometry>
                <box size="0.3 0.3 0.05"/>
            </geometry>
            <material name="red" />
        </visual>
    </link>
    <joint name="driver_joint" type="fixed">
        <parent link="chassis" />
        <child link="driver" />
        <origin rpy="0 0 0" xyz="0 -0.15 0.055"/>
    </joint>

    <link name="ir1">
        <visual>
            <geometry>
                <box size="0.1 0.1 0.1"/>
            </geometry>
            <material name="blue" />
        </visual>
    </link>
    <joint name="ir1_joint" type="fixed">
        <parent link="chassis" />
        <child link="ir1" />
        <origin rpy="0 0 0" xyz="0.45 0.25 0.08"/>
    </joint>

    <link name="ir2">
        <visual>
            <geometry>
                <box size="0.1 0.1 0.1"/>
            </geometry>
            <material name="blue" />
        </visual>
    </link>
    <joint name="ir2_joint" type="fixed">
        <parent link="chassis" />
        <child link="ir2" />
        <origin rpy="0 0 0" xyz="0.45 0.1 0.08"/>
    </joint>

    <link name="ir3">
        <visual>
            <geometry>
                <box size="0.1 0.1 0.1"/>
            </geometry>
            <material name="blue" />
        </visual>
    </link>
    <joint name="ir3_joint" type="fixed">
        <parent link="chassis" />
        <child link="ir3" />
        <origin rpy="0 0 0" xyz="0.45 -0.1 0.08"/>
    </joint>

    <link name="ir4">
        <visual>
            <geometry>
                <box size="0.1 0.1 0.1"/>
            </geometry>
            <material name="blue" />
        </visual>
    </link>
    <joint name="ir4_joint" type="fixed">
        <parent link="chassis" />
        <child link="ir4" />
        <origin rpy="0 0 0" xyz="0.45 -0.25 0.08"/>
    </joint>

    <link name="motor1">
        <visual>
            <geometry>
                <box size="0.1 0.15 0.1"/>
            </geometry>
            <material name="blue" />
        </visual>
    </link>
    <joint name="motor1_joint" type="fixed">
        <parent link="chassis" />
        <child link="motor1" />
        <origin rpy="0 0 0" xyz="-0.3 -0.225 -0.08"/>
    </joint>

    <link name="motor2">
        <visual>
            <geometry>
                <box size="0.1 0.15 0.1"/>
            </geometry>
            <material name="blue" />
        </visual>
    </link>
    <joint name="motor2_joint" type="fixed">
        <parent link="chassis" />
        <child link="motor2" />
        <origin rpy="0 0 0" xyz="-0.3 0.225 -0.08"/>
    </joint>

    <link name="wheel1">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.1" />
            </geometry>
            <material name="black_2" />
        </visual>
    </link>
    <joint name="wheel1_joint" type="fixed">
        <parent link="motor1" />
        <child link="wheel1" />
        <origin rpy="1.57 0 0" xyz="0 -0.125 0"/>
    </joint>

    <link name="wheel2">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.1" />
            </geometry>
            <material name="black_2" />
        </visual>
    </link>
    <joint name="wheel2_joint" type="fixed">
        <parent link="motor2" />
        <child link="wheel2" />
        <origin rpy="1.57 0 0" xyz="0 0.125 0"/>
    </joint>

    <link name="iwheel1">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.1" />
            </geometry>
            <material name="yellow" />
        </visual>
    </link>
    <joint name="iwheel1_joint" type="fixed">
        <parent link="motor1" />
        <child link="iwheel1" />
        <origin rpy="1.57 0 0" xyz="0 -0.125 0"/>
    </joint>

    <link name="iwheel2">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.1" />
            </geometry>
            <material name="yellow" />
        </visual>
    </link>
    <joint name="iwheel2_joint" type="fixed">
        <parent link="motor2" />
        <child link="iwheel2" />
        <origin rpy="1.57 0 0" xyz="0 0.125 0"/>
    </joint>


    <link name="switch">
        <visual>
            <geometry>
                <cylinder radius="0.025" length="0.02" />
            </geometry>
            <material name="black" />
        </visual>
    </link>
    <joint name="switch_joint" type="fixed">
        <parent link="chassis" />
        <child link="switch" />
        <origin rpy="0 0 0" xyz="-0.4 0.25 0.04"/>
    </joint>
</robot>